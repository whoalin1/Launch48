# Public canonical URL used for metadata, robots.txt, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://launch48.example

# Hosted OxaPay crypto payment link.
NEXT_PUBLIC_OXAPAY_PAYMENT_URL=https://app.oxapay.com/payment/your-payment-link

# Hosted card payment link fallback (optional)
NEXT_PUBLIC_CARD_PAYMENT_URL=

# Rampex Card Payment Gateway (https://rampex.io/api-docs)
RAMPEX_API_KEY=rpx_live_your_key_here
RAMPEX_WEBHOOK_SECRET=your_webhook_secret_here
