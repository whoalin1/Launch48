# OxaPay Merchant Service credentials. Keep the Merchant API Key server-only.
# Use true for test invoices and false for real crypto payments.
OXAPAY_MERCHANT_API_KEY=replace_with_merchant_api_key
OXAPAY_SANDBOX=true

# Canonical HTTPS origin used for OxaPay callback and return URLs.
SITE_URL=https://launch48-psi.vercel.app

# Preferred order storage. Use a dedicated Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Fallback when DATABASE_URL is unset. Both values are required. The token needs
# Issues: Read and write permission for the public repository whoalin1/Launch48.
# Generate a unique secret with: openssl rand -hex 32
# Pending briefs are encrypted; verified paid briefs become public issues.
GITHUB_ISSUES_TOKEN=github_pat_replace_me
CHECKOUT_STATE_SECRET=replace_with_at_least_32_random_bytes
