# Polar server credentials. Use matching credentials and product IDs from one
# environment only: sandbox for testing, production for real payments.
POLAR_ACCESS_TOKEN=polar_oat_replace_me
POLAR_PRODUCT_ID=00000000-0000-0000-0000-000000000000
POLAR_WEBHOOK_SECRET=polar_whs_replace_me
NEXT_PUBLIC_POLAR_SERVER=production

# Preferred order storage. Use a dedicated Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Emergency fallback when DATABASE_URL is unset. The token needs Issues: Read
# and write permission for the public repository whoalin1/Launch48.
GITHUB_ISSUES_TOKEN=github_pat_replace_me

# Optional alternate name; used only if GITHUB_ISSUES_TOKEN is unset.
# GITHUB_TOKEN=github_pat_replace_me
